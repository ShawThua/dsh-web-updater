{
  "name": "dsh-web-updater",
  "version": "0.1.1",
  "description": "Check the DSH nightly update feed, download and sha512-verify the installer, and install it from the web GUI while restarting the web host afterwards.",
  "license": "MIT",
  "author": "ShawThua",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/version.test.mjs && node test/feed.test.mjs && node test/args.test.mjs && node test/client.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/args.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "updater",
    "update",
    "installer",
    "web"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawThua/dsh-web-updater.git"
  },
  "homepage": "https://github.com/ShawThua/dsh-web-updater#readme",
  "bugs": {
    "url": "https://github.com/ShawThua/dsh-web-updater/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}

